# Copier en .env (jamais commité) et remplir.
SECRET_KEY=
DEBUG=False
ENVIRONMENT=PROD
DB_NAME=
DB_USER=
DB_PASSWORD=
DB_HOST=localhost
DB_PORT=3306
DB_CONN_MAX_AGE=60

EMAIL_HOST=smtp.hostinger.com
EMAIL_PORT=465
EMAIL_USE_SSL=True
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=

# SMS HSMS (https://www.hsms.ci/doc-api/)
HSMS_EMAIL=
HSMS_PASSWORD=
HSMS_CLIENT_ID=
HSMS_CLIENT_SECRET=
# Longue chaîne aléatoire, ex. : python -c "import secrets; print(secrets.token_urlsafe(32))"
HSMS_WEBHOOK_SECRET=

# Administration Django (paramètres et modèles SMS), réservée aux super-utilisateurs
ADMIN_URL=direction-mlcod/
